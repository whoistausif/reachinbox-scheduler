PORT=4000
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me

DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# Google OAuth (redirect URI: ${BACKEND_URL}/api/auth/google/callback)
GOOGLE_CLIENT_ID= 
GOOGLE_CLIENT_SECRET= 

# Slack OAuth (redirect URI must be HTTPS: ${BACKEND_URL}/api/slack/callback -> use ngrok/cloudflared)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=

# Worker / throughput
RUN_WORKER=true
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_SENDS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=100
SENDER_COUNT=3
